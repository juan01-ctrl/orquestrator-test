---
const title = 'Sign Up Now';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sign up today." />
    <meta name="theme-color" content="#6d28d9" />
    <title>{title}</title>
  </head>
  <body>
    <main aria-label="Sign up offer">
      <section class="popup" role="dialog" aria-modal="true" aria-labelledby="popup-title">
        <button class="close" type="button" aria-label="Close sign up pop-up" onclick="this.closest('.popup').hidden = true">
          <span aria-hidden="true">×</span>
        </button>
        <div class="sparkle" aria-hidden="true">✦</div>
        <p class="eyebrow">A little something for you</p>
        <h1 id="popup-title">Sign Up Now</h1>
        <p class="message">Be the first to hear about what’s new.</p>
        <a class="signup" href="mailto:hello@example.com">Join the list <span aria-hidden="true">↗</span></a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #6d28d9; }
  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    padding: 1.5rem;
    place-items: center;
    color: #24113f;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: radial-gradient(ellipse at 50% 0%, #a78bfa 0, #7c3aed 42%, #4c1d95 100%);
  }
  main { width: min(100%, 34rem); }
  .popup {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 8vw, 4.5rem) clamp(1.5rem, 7vw, 4rem);
    border: 1px solid #ffffffa8;
    border-radius: 1.75rem;
    background: #fffdf8;
    box-shadow: 0 2rem 5rem #2e106566, 0 0 0 8px #ffffff20;
    text-align: center;
    animation: arrive 450ms cubic-bezier(.2,.8,.2,1) both;
  }
  .popup[hidden] { display: none; }
  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #624a7e;
    background: #f1eafb;
    cursor: pointer;
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    transition: color 150ms ease, background 150ms ease, transform 150ms ease;
  }
  .close:hover { color: white; background: #6d28d9; transform: rotate(90deg); }
  .close:focus-visible, .signup:focus-visible { outline: 3px solid #7c3aed; outline-offset: 4px; }
  .sparkle { display: grid; width: 3.5rem; height: 3.5rem; margin: 0 auto 1.25rem; place-items: center; border-radius: 1.2rem; color: #6d28d9; background: #efe7ff; font-size: 1.8rem; }
  .eyebrow { margin: 0 0 .75rem; color: #76579a; font-size: .75rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0; color: #291446; font-size: clamp(2.5rem, 9vw, 4rem); line-height: .98; letter-spacing: -.065em; }
  .message { max-width: 20rem; margin: 1.25rem auto 0; color: #715f82; font-size: 1.05rem; line-height: 1.6; }
  .signup { display: inline-flex; gap: .65rem; align-items: center; justify-content: center; margin-top: 1.75rem; padding: .95rem 1.5rem; border-radius: 999px; color: white; background: #6d28d9; box-shadow: 0 .5rem 1.2rem #6d28d944; font-weight: 750; text-decoration: none; transition: transform 160ms ease, background 160ms ease; }
  .signup:hover { transform: translateY(-2px); background: #5b21b6; }
  @keyframes arrive { from { opacity: 0; transform: translateY(14px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (prefers-reduced-motion: reduce) { .popup { animation: none; } *, *::before, *::after { transition-duration: .01ms !important; } }
</style>
