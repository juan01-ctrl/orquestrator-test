---
const title = 'Sign Up Now';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Un proyecto Astro listo para empezar a desarrollar." />
    <meta name="theme-color" content="#101820" />
    <title>{title}</title>
  </head>
  <body>
    <main aria-hidden="true">
      <p class="eyebrow">Tu próximo proyecto empieza acá</p>
      <h1>Hola, Astro.</h1>
      <p class="intro">Una base liviana, rápida y lista para construir algo nuevo.</p>
      <a href="https://docs.astro.build/" target="_blank" rel="noreferrer">Explorar la documentación <span aria-hidden="true">↗</span></a>
    </main>
    <div class="overlay" id="signup-overlay">
      <section class="popup" role="dialog" aria-modal="true" aria-labelledby="signup-title">
        <button class="close" type="button" aria-label="Close sign up pop-up">×</button>
        <h2 id="signup-title">Sign Up Now</h2>
      </section>
    </div>
    <script>
      const overlay = document.querySelector('#signup-overlay');
      const closeButton = document.querySelector('.close');
      closeButton?.addEventListener('click', () => overlay?.remove());
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #101820; }
  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    padding: 2rem;
    place-items: center;
    color: #f4f1e8;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: radial-gradient(ellipse at 50% 0%, #253d48 0, #101820 62%);
  }
  main { width: min(100%, 46rem); padding: clamp(2rem, 8vw, 5rem); border: 1px solid #ffffff20; border-radius: 1.5rem; background: #ffffff08; box-shadow: 0 2rem 6rem #0004; }
  .eyebrow { color: #b7dc72; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 1.25rem 0 .75rem; font-size: clamp(3rem, 10vw, 6rem); line-height: .98; letter-spacing: -.07em; }
  .intro { max-width: 28rem; color: #bac5ca; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.6; }
  a { display: inline-flex; gap: .6rem; align-items: center; margin-top: 1.5rem; color: #101820; background: #b7dc72; border-radius: 999px; padding: .85rem 1.2rem; font-weight: 700; text-decoration: none; transition: transform 160ms ease, background 160ms ease; }
  a:hover { transform: translateY(-2px); background: #c8ed82; }
  a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
  .overlay {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: grid;
    padding: 1.5rem;
    place-items: center;
    background: #10091dcc;
  }
  .popup {
    position: relative;
    display: grid;
    width: min(100%, 28rem);
    min-height: 15rem;
    padding: 3rem 2rem;
    place-items: center;
    border: 1px solid #ffffff42;
    border-radius: 1.5rem;
    color: #fff;
    background: linear-gradient(145deg, #9b5de5, #5a189a);
    box-shadow: 0 2rem 6rem #0008;
    text-align: center;
  }
  .popup h2 { margin: 0; font-size: clamp(2.5rem, 10vw, 4rem); line-height: 1; letter-spacing: -.06em; }
  .close {
    position: absolute;
    top: .75rem;
    right: .75rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    border: 1px solid #ffffff80;
    border-radius: 50%;
    color: white;
    background: #ffffff1c;
    font: inherit;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { background: #ffffff38; }
  .close:focus-visible { outline: 3px solid white; outline-offset: 3px; }
</style>
