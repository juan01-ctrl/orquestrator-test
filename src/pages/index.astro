---
const title = 'Sign Up Now';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#6d28d9" />
    <title>{title}</title>
  </head>
  <body>
    <main aria-label="Sign up promotion">
      <section class="popup" role="dialog" aria-modal="true" aria-labelledby="popup-title">
        <button class="close" type="button" aria-label="Close pop-up">&times;</button>
        <p class="eyebrow">A fresh start</p>
        <h1 id="popup-title">Sign Up Now</h1>
      </section>
    </main>
    <script>
      const popup = document.querySelector('.popup');
      const closeButton = document.querySelector('.close');

      closeButton?.addEventListener('click', () => {
        popup?.setAttribute('hidden', '');
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #6d28d9; }
  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    padding: 1.5rem;
    place-items: center;
    color: #2e1065;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: radial-gradient(ellipse at 50% 0%, #a78bfa 0, #6d28d9 68%);
  }
  main { width: min(100%, 32rem); }
  .popup {
    position: relative;
    padding: clamp(3.5rem, 10vw, 5.5rem) clamp(2rem, 8vw, 4rem);
    border: 1px solid #ffffffa8;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 2rem 6rem #2e106566;
    text-align: center;
  }
  .popup[hidden] { display: none; }
  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #4c1d95;
    background: #f3e8ff;
    font: inherit;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { background: #e9d5ff; }
  .close:focus-visible { outline: 3px solid #7c3aed; outline-offset: 3px; }
  .eyebrow { margin: 0 0 .75rem; color: #7c3aed; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.5rem, 10vw, 4rem); line-height: 1; letter-spacing: -.06em; }
</style>
