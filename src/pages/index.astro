---
const title = 'Sign up for Orchestrix';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sign up for Orchestrix." />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <main class="signup-page">
      <section class="signup-content" aria-labelledby="signup-title">
        <a class="wordmark" href="#home" aria-label="Orchestrix home"><span aria-hidden="true">◈</span> Orchestrix</a>
        <h1 id="signup-title">Sign up for Orchestrix</h1>
        <p class="intro">Enter your email to get started.</p>
        <form action="#" method="get">
          <label class="visually-hidden" for="email">Email address</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Email address" required />
          <button type="submit">
            <svg aria-hidden="true" viewBox="0 0 20 20"><rect x="1.5" y="3" width="17" height="14" rx="1.5" /><path d="m2.5 4 7.5 6 7.5-6" /></svg>
            <span>Continue with Email</span>
          </button>
        </form>
        <div class="divider"><span>OR</span></div>
        <a class="other-options" href="#signup-options">Other sign up options <span aria-hidden="true">→</span></a>
        <p class="account-prompt">Already have an account? <a href="#login">Log in</a></p>
      </section>

      <footer>
        <p>By joining, you agree to our <a href="#terms">Terms of Service</a> and <a href="#privacy">Privacy Policy</a></p>
        <div class="footer-rule" aria-hidden="true"></div>
        <p>Have a complex company use case? <a href="#enterprise">Get enterprise-grade assistance</a></p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-width: 320px; min-height: 100%; color-scheme: dark; background: #000; }
  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100svh;
    margin: 0;
    color: #ededed;
    background: #000;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .signup-page { position: relative; display: flex; min-height: 100vh; min-height: 100svh; flex-direction: column; align-items: center; justify-content: center; padding: 48px 20px 180px; background: radial-gradient(ellipse at 50% 28%, #111 0, #050505 43%, #000 78%); transition: background .5s ease; }
  .signup-page:has(button:hover) { background: radial-gradient(ellipse at 50% 28%, #174b86 0, #0b2b50 43%, #06172b 78%); }
  .signup-content { width: min(100%, 360px); padding: 30px; border: 1px solid #292929; border-radius: 12px; background: rgba(8, 8, 8, .88); box-shadow: 0 20px 80px rgba(0, 0, 0, .55); text-align: center; }
  .wordmark { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 26px; color: #f5f5f5; font-size: 15px; font-weight: 600; letter-spacing: -.35px; text-decoration: none; }
  .wordmark span { font-size: 21px; }
  h1 { margin: 0 0 7px; color: #fafafa; font-size: 23px; font-weight: 600; letter-spacing: -.8px; line-height: 1.25; }
  .intro { margin: 0 0 24px; color: #888; font-size: 13px; }
  form { display: grid; gap: 10px; }
  input { width: 100%; height: 42px; padding: 0 12px; border: 1px solid #383838; border-radius: 6px; outline: none; color: #f5f5f5; background: #050505; font: inherit; font-size: 13px; transition: border-color .15s, box-shadow .15s; }
  input::placeholder { color: #777; }
  input:focus { border-color: #888; box-shadow: 0 0 0 2px rgba(255,255,255,.08); }
  button { position: relative; display: flex; width: 100%; height: 42px; align-items: center; justify-content: center; border: 1px solid #e5e5e5; border-radius: 6px; color: #111; background: #fafafa; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .15s; }
  button:hover { background: #e9e9e9; }
  button svg { position: absolute; left: 11px; width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .divider { display: flex; align-items: center; gap: 12px; margin: 21px 0 17px; color: #626262; font-size: 10px; letter-spacing: .08em; }
  .divider::before, .divider::after { height: 1px; flex: 1; background: #272727; content: ""; }
  .other-options { display: inline-flex; align-items: center; gap: 6px; color: #aaa; font-size: 13px; line-height: 1.4; text-decoration: none; }
  .other-options:hover { color: #66adff; }
  .account-prompt { margin: 25px 0 0; color: #777; font-size: 12px; }
  .account-prompt a { color: #ededed; text-decoration: none; }
  .account-prompt a:hover { text-decoration: underline; }
  footer { position: absolute; right: 20px; bottom: 30px; left: 20px; color: #777; font-size: 11px; line-height: 1.5; text-align: center; }
  footer p { margin: 0; }
  footer a { color: #f3f3f3; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .footer-rule { width: min(100%, 350px); height: 1px; margin: 18px auto; background: #252525; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
  button:focus-visible, a:focus-visible { outline: 2px solid #3291ff; outline-offset: 3px; }
  @media (max-width: 520px) {
    .signup-page { justify-content: flex-start; padding: clamp(52px, 12vh, 90px) 16px 160px; }
    .signup-content { padding: 26px 22px; }
    footer { bottom: 24px; }
    .footer-rule { margin: 15px auto; }
  }
  @media (max-height: 480px) {
    .signup-page { min-height: 480px; }
    .signup-content { margin-top: 60px; }
    footer { bottom: 20px; }
  }
</style>
