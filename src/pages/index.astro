---
const title = 'Sign up for Vercel';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sign up for Vercel." />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <main class="signup-page">
      <section class="signup-content" aria-labelledby="signup-title">
        <h1 id="signup-title">Sign up for Vercel</h1>
        <form action="#" method="get">
          <label class="visually-hidden" for="email">Email address</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" value="saasui" required />
          <button type="submit">
            <svg aria-hidden="true" viewBox="0 0 20 20"><rect x="1.5" y="3" width="17" height="14" rx="1.5" /><path d="m2.5 4 7.5 6 7.5-6" /></svg>
            <span>Continue with Email</span>
          </button>
        </form>
        <a class="other-options" href="#signup-options"><span aria-hidden="true">←</span> Other Sign Up Options</a>
      </section>

      <footer>
        <p>By joining, you agree to our <a href="#terms">Terms of Service</a> and <a href="#privacy">Privacy Policy</a></p>
        <div class="footer-rule" aria-hidden="true"></div>
        <p>Have a complex company use case? <a href="#enterprise">Get enterprise-grade assistance</a></p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-width: 320px; min-height: 100%; color-scheme: dark; background: #000; }
  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    min-height: 100svh;
    margin: 0;
    color: #ededed;
    background: #000;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .signup-page { position: relative; display: flex; min-height: 100vh; min-height: 100svh; flex-direction: column; align-items: center; border-right: 1px solid #17131b; border-left: 1px solid #17131b; }
  .signup-content { width: min(100% - 40px, 270px); margin-top: 115px; text-align: center; }
  h1 { margin: 0 0 24px; color: #fafafa; font-size: 34px; font-weight: 700; letter-spacing: -1.55px; line-height: 1.2; white-space: nowrap; }
  form { display: grid; gap: 10px; }
  input { width: 100%; height: 40px; padding: 0 11px; border: 1px solid #666; border-radius: 5px; outline: none; color: #f5f5f5; background: #050505; font: inherit; font-size: 13px; }
  input:focus { border-color: #888; box-shadow: 0 0 0 1px #888; }
  button { position: relative; display: flex; width: 100%; height: 41px; align-items: center; justify-content: center; border: 1px solid #e5e5e5; border-radius: 5px; color: #111; background: #fafafa; font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; }
  button:hover { background: #e9e9e9; }
  button svg { position: absolute; left: 11px; width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .other-options { display: inline-flex; align-items: center; gap: 5px; margin-top: 19px; color: #3291ff; font-size: 13px; line-height: 1.4; text-decoration: none; }
  .other-options:hover { color: #66adff; }
  footer { position: absolute; right: 20px; bottom: 42px; left: 20px; color: #777; font-size: 11px; line-height: 1.5; text-align: center; }
  footer p { margin: 0; }
  footer a { color: #f3f3f3; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .footer-rule { width: min(100%, 350px); height: 1px; margin: 26px auto; background: #252525; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
  button:focus-visible, a:focus-visible { outline: 2px solid #3291ff; outline-offset: 3px; }
  @media (max-width: 520px) {
    .signup-content { margin-top: clamp(80px, 16vh, 115px); }
    h1 { font-size: clamp(27px, 7vw, 34px); letter-spacing: -1.2px; }
    footer { bottom: 28px; }
    .footer-rule { margin: 20px auto; }
  }
  @media (max-height: 480px) {
    .signup-page { min-height: 480px; }
    .signup-content { margin-top: 60px; }
    footer { bottom: 20px; }
  }
</style>
